[Unit]
Description=Qiantie V88 Go application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/qiantie/v88/direct/current
EnvironmentFile=-/etc/qiantie/v88.env
ExecStart=/opt/qiantie/v88/direct/current/go/qiantie
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
