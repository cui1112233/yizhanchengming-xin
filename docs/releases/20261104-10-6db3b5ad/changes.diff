+    radial-gradient(circle at 38% 78%, rgba(153, 207, 255, 0.22) 0 1px, transparent 1.8px),
+    radial-gradient(circle at 86% 84%, rgba(255, 255, 255, 0.2) 0 1px, transparent 1.6px);
+  background-size: 230px 190px, 310px 260px, 280px 220px, 370px 310px;
+  animation: qiantie-stars-drift 42s linear infinite;
