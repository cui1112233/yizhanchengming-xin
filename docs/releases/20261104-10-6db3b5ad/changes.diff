+  }
+
+  .home-hero-actions-right {
+    position: absolute;
+    top: 10px;
+    right: 14px;
+  }
+
+  .home-hero-brand {
+    min-height: 38px;
+    padding-right: 132px;
+  }
+
+  .home-hero-title {
