+    />
+  );
+}
+
+function EnrichmentList({ title, items }) {
+  return <div style={{ marginTop: 12 }}><Typography.Text strong>{title}</Typography.Text><ul style={{ margin: '6px 0 0', paddingLeft: 20 }}>{items.map(item => <li key={item}>{item}</li>)}</ul></div>;
+}
