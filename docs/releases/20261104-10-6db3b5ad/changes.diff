+	if json.Unmarshal(raw, &payload) != nil {
+		return false
+	}
+	for _, object := range videoObjects(payload) {
+		for _, key := range keys {
+			switch typed := object[key].(type) {
+			case bool:
+				return typed
+			case string:
+				switch strings.ToLower(strings.TrimSpace(typed)) {
+				case "true", "1", "yes":
+					return true
+				}
+			case float64:
+				return typed != 0
+			}
+		}
+	}
+	return false
+}
