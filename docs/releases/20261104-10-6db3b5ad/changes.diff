+			t.Fatal(err)
+		}
+		if len(variants) != 0 {
+			t.Fatalf("variants = %d, want 0", len(variants))
+		}
+		if len(provider.calls) != 0 {
+			t.Fatalf("provider must not be called for a single storyboard, calls=%d", len(provider.calls))
+		}
+	})
+}
