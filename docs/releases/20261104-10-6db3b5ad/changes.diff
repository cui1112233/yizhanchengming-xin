+.script-shot-preset-tags {
+  display: flex;
+  flex: 1 1 auto;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 5px;
+  min-width: 0;
+}
+
+.script-shot-preset-tag {
+  appearance: none;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  min-height: 24px;
+  max-width: 180px;
+  padding: 2px 9px;
+  overflow: hidden;
+  color: #82e4c6;
+  border: 1px solid #3b7167;
+  border-radius: 4px;
+  background: #183a39;
+  font-size: 12px;
+  line-height: 18px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.script-shot-preset-tag.is-disabled {
+  color: var(--legacy-muted);
+  border-color: var(--legacy-border);
+  background: var(--legacy-card);
+  text-decoration: line-through;
+}
+/* 深色主题下的全局错误弹层必须保持可读，避免文字与深色背景混在一起。 */
+[data-theme='dark'] .ant-modal-confirm-error .ant-modal-content,
+[data-theme='dark'] .ant-message-error .ant-message-notice-content {
+  color: #f8fbff;
+  background: #182235;
+  border: 1px solid #ff7875;
+}
+
+.legacy-global-status { position: absolute; left: 25%; right: 25%; top: 50%; transform: translateY(-50%); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13px; font-weight: 600; pointer-events: none; }
+.legacy-global-status--working { color: var(--text-link); }
+.legacy-global-status--success { color: var(--text-success); }
+.legacy-global-status--error { color: var(--text-danger); }
+.legacy-global-status--idle { color: var(--text-tertiary); }
+
+[data-theme='dark'] .ant-modal-confirm-error .ant-modal-confirm-title,
+[data-theme='dark'] .ant-modal-confirm-error .ant-modal-confirm-content,
+[data-theme='dark'] .ant-message-error .ant-message-notice-content {
+  color: #f8fbff;
+}
