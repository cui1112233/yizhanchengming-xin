+  const [displayURL, setDisplayURL] = useState('');
+  useEffect(() => {
+    let active = true;
+    let objectURL = '';
+    const previewURL = comicPageReferencePreviewURL(referenceURL);
+    if (!previewURL) { setDisplayURL(''); return undefined; }
+    getComicReferencePreviewBlob(previewURL).then(blob => {
