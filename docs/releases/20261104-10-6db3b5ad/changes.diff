+
+body::after {
+  background-image:
+    radial-gradient(circle at 22% 62%, rgba(255, 255, 255, 0.16) 0 1px, transparent 1.6px),
+    radial-gradient(circle at 58% 12%, rgba(154, 201, 255, 0.18) 0 1px, transparent 1.7px),
