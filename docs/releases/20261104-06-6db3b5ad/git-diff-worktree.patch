+  box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 12%, transparent);
+}
+
+.script-workbench-form .script-left .private-customization-workspaces {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  width: 100%;
+  margin: 0 0 18px;
+  padding: 4px;
+  gap: 4px;
+  border: 1px solid var(--pc-border-soft);
+  border-radius: 11px;
+  background: color-mix(in srgb, var(--surface-input) 60%, transparent);
+}
+
+.script-workbench-form .script-left .private-customization-workspaces button {
+  width: 100%;
+  min-width: 0;
+  padding: 8px 8px;
+  border: 0;
+  border-radius: 8px;
+  color: var(--text-tertiary);
+  background: transparent;
+  font-size: 11px;
+}
+
+.script-workbench-form .script-left .private-customization-workspaces button:hover {
+  transform: none;
+  color: var(--text-primary);
+  background: color-mix(in srgb, var(--surface-panel) 78%, transparent);
+}
+
+.script-workbench-form .script-left .private-customization-workspaces button.is-active {
+  border: 0;
+  color: var(--text-primary);
+  background: var(--pc-accent-soft);
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06);
+}
+
+.script-workbench-form .private-customization-title-line {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.script-workbench-form .private-customization-ready-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 8px;
+  border: 1px solid color-mix(in srgb, var(--pc-mint) 48%, var(--pc-border-soft));
+  border-radius: 999px;
+  color: var(--pc-mint);
+  background: rgba(103, 223, 203, .06);
+  font-size: 10px;
+  font-weight: 600;
+  line-height: 1;
+  white-space: nowrap;
+}
+
+.script-workbench-form .private-customization-work-meta {
+  margin: 6px 0 0;
+  color: var(--text-tertiary);
+  font-size: 11px;
+  line-height: 1.4;
+}
+
+/* 两个工作区共用一套窄栏，避免漫画页切换后列宽又变宽。 */
+.script-workbench-form > .private-comic-workbench {
+  grid-template-columns: 304px minmax(0, 1fr);
+}
+
+.script-workbench-form .private-customization-save-state,
+.script-workbench-form .private-customization-status-dot {
+  display: inline-flex;
+  flex: 0 0 auto;
+  align-items: center;
+  gap: 6px;
+  border: 1px solid var(--pc-border-soft);
+  border-radius: 999px;
+  padding: 5px 8px;
+  color: var(--text-tertiary);
+  background: color-mix(in srgb, var(--surface-input) 46%, transparent);
+  font-size: 10px;
+  line-height: 1;
+  white-space: nowrap;
+}
+
+.script-workbench-form .private-customization-status-dot {
+  border-color: color-mix(in srgb, var(--pc-mint) 42%, var(--pc-border-soft));
+  color: var(--pc-mint);
+  background: rgba(103, 223, 203, .06);
+}
+
+.script-workbench-form .private-customization-status-dot i {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--pc-mint);
+  box-shadow: 0 0 0 3px rgba(103, 223, 203, .12);
+}
+
+.script-workbench-form .script-right > .script-tabs {
+  min-height: 50px;
+  padding-top: 8px;
+  padding-bottom: 8px;
+  background: color-mix(in srgb, var(--surface-panel) 68%, transparent);
+}
+
+.script-workbench-form .script-right > .script-tabs > .ant-typography {
+  display: none;
+}
+
+.script-workbench-form .script-right > .script-tabs > .ant-btn-text:first-of-type {
+  margin-left: auto;
+}
+
+.script-workbench-form .script-right > .script-tabs > .ant-btn-text:last-child {
+  margin-left: 0;
+}
+
+.script-workbench-form .script-right > .script-toolbar {
+  background: color-mix(in srgb, var(--surface-panel) 78%, transparent);
+}
+
+@media (max-width: 680px) {
+  .script-workbench-form .private-customization-panel-heading,
+  .script-workbench-form .private-customization-canvas-heading {
+    flex-direction: column;
+    gap: 9px;
+  }
+
+  .script-workbench-form .private-customization-canvas-heading {
