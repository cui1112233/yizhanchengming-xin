+	c.mu.Lock()
+	defer c.mu.Unlock()
+	state, err := c.loadLocked()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, job := range state.Jobs {
+		if automationStringValue(job["owner"], "") == owner && automationStringValue(job["batchId"], "") == batchID {
+			return job
+		}
+	}
+	t.Fatalf("job not found for owner=%s batch=%s", owner, batchID)
+	return nil
+}
