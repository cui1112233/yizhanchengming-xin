+}
+
+// Billing reconciliation remains scoped to the authenticated token. Request IDs
+// only narrow that scope; they never select another account's records.
+func GetLogsByTokenRequestIDs(tokenID int, requestIDs []string) (logs []*Log, err error) {
+	if tokenID <= 0 || len(requestIDs) == 0 || len(requestIDs) > 50 { return []*Log{}, nil }
+	err = LOG_DB.Model(&Log{}).Where("token_id = ? AND request_id IN ?", tokenID, requestIDs).Order("id desc").Limit(100).Find(&logs).Error
 	formatUserLogs(logs, 0)
 	return logs, err
 }
