      ],
      "value": " estimated input tokens",
      "index": 26
    },
    {
      "tag": "u",
      "fileRange": [
        4106357,
        4106412
      ],
      "value": "## Protected Context (reference only, do not compile)",
      "index": 27
    },
    {
      "tag": "a",
