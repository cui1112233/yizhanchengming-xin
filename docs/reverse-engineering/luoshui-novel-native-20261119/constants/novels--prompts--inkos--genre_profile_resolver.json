        "values": [
          {
            "tag": "u",
            "fileRange": [
              4156906,
              4157007
            ],
            "value": "玄幻升级流：力量体系清晰、节奏明快、爽点密集，主角成长线贯穿全书。"
          },
          {
            "tag": "u",
            "fileRange": [
              4157007,
              4157099
            ],
            "value": "仙侠修真：境界体系、宗门势力、天地规则，注重修炼逻辑与因果。"
          },
          {
            "tag": "u",
            "fileRange": [
              4157099,
              4157191
            ],
            "value": "都市现实：贴近当代生活，冲突来自社会关系、职场、家庭与阶层。"
          },
          {
            "tag": "u",
            "fileRange": [
              4157191,
              4157271
            ],
            "value": "言情：情感推进为核心，关系张力与情绪回报是主发动机。"
          },
          {
            "tag": "u",
            "fileRange": [
              4157271,
              4157348
            ],
            "value": "悬疑推理：信息释放节奏、证据链、反转与读者参与感。"
          },
          {
            "tag": "u",
            "fileRange": [
              4157348,
              4157437
            ],
            "value": "历史：时代锚、政策与社会环境不可违背，人物命运与时代绑定。"
          },
          {
            "tag": "u",
            "fileRange": [
              4157437,
              4157497
            ],
            "value": "科幻：技术/设定自洽，世界观规则可推演。"
          },
          {
            "tag": "u",
            "fileRange": [
              4157497,
              4157556
            ],
            "value": "游戏异界：系统、数值、副本与升级反馈。"
          },
          {
            "tag": "u",
            "fileRange": [
              4157556,
              4157639
            ],
            "value": "通用网文：人物驱动、冲突明确、章末留钩、节奏张弛有度。"
          }
        ]
      },
      "index": 47
